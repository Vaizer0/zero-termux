#!/data/data/com.termux/files/usr/bin/bash

SOURCE="${BASH_SOURCE[0]}"

# resolver symlink si existe
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done

BIN_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

# root del proyecto
ZERO_PATH="$(cd "$BIN_DIR/.." && pwd)"

# cargar bootstrap
source "$ZERO_PATH/utils/bootstrap.sh"

# cargar entorno
import "@/utils/env"

# ===== CHECK UPDATES =====
check_for_updates() {
  local version_file="$ZERO_CACHE/last_version_check"
  local current_time=$(date +%s)
  local check_interval=86400  # 24 hours in seconds
  local last_check=0

  # Read last check
  if [[ -f "$version_file" ]]; then
    last_check=$(cat "$version_file" 2>/dev/null | head -1)
  fi

  # Check if 24 hours have passed
  if (( current_time - last_check < check_interval )); then
    return 0
  fi

  # Save current timestamp
  mkdir -p "$ZERO_CACHE"
  echo "$current_time" > "$version_file"

  # Check updates in background (do not block)
  (
    local remote_version=$(curl -fsSL "https://raw.githubusercontent.com/Vaizer0/zero-termux/main/zero/utils/env.sh" 2>/dev/null | grep "ZERO_VERSION=" | cut -d'"' -f2)
    local local_version="$ZERO_VERSION"

    if [[ -n "$remote_version" ]] && [[ "$remote_version" != "$local_version" ]]; then
      echo "$remote_version" > "$ZERO_CACHE/new_version"
    fi
  ) &>/dev/null &
}

# Show update notification
show_update_notification() {
  local new_version_file="$ZERO_CACHE/new_version"

  if [[ -f "$new_version_file" ]]; then
    local new_version=$(cat "$new_version_file")
    echo
    separator_section "Update Available"
    echo
    log_warn "New version available: ${D_GREEN}$new_version${D_NC} (current: ${D_CYAN}$ZERO_VERSION${D_NC})"
    echo
    list_item "Run: ${D_CYAN}zero update zero${D_NC} to update"
    echo
  fi
}

# Check updates (only if not an update command)
if [[ "$1" != "update" ]] && [[ "$1" != "uninstall" ]] && [[ "$1" != "reinstall" ]]; then
  check_for_updates
  
  # Import logs for the notification
  import "@/utils/log"
  import "@/utils/colors"
  
  show_update_notification
fi

# load CLI
import "@/cli/zero"

zero_main "$@"
