#!/data/data/com.termux/files/usr/bin/bash
set -e

REPO="https://github.com/gitleaks/gitleaks.git"
# Zero-Termux: rolling — resolve latest upstream release tag at install time
TAG="$(curl -fsSL --max-time 30 'https://api.github.com/repos/gitleaks/gitleaks/releases/latest' 2>/dev/null | grep '"tag_name"' | head -1 | cut -d'"' -f4)"
[ -n "$TAG" ] || { echo 'Error: failed to resolve latest gitleaks release' >&2; exit 1; }
TMP_DIR="$TMPDIR/gitleaks-build"
BIN_DIR="$PREFIX/bin"

rm -rf "$TMP_DIR" 2>/dev/null || true

git clone --depth 1 --branch "$TAG" -q "$REPO" "$TMP_DIR"
cd "$TMP_DIR"

go build -trimpath -ldflags "-w -s" -o gitleaks

install -Dm755 gitleaks "$BIN_DIR/gitleaks"

cd /
rm -rf "$TMP_DIR"

echo "gitleaks installed. Run 'gitleaks'"
exit 0
