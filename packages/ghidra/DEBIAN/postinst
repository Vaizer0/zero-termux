#!/data/data/com.termux/files/usr/bin/bash
set -e

GHIDRA_DIR="$PREFIX/share/ghidra"
DESKTOP_DIR="$PREFIX/share/applications"
# Zero-Termux: rolling version — resolve latest GitHub release at install time
DOWNLOAD_URL="$(curl -fsSL 'https://api.github.com/repos/NationalSecurityAgency/ghidra/releases/latest' 2>/dev/null | grep '"browser_download_url"' | grep '\.zip' | head -1 | cut -d'"' -f4)"
[ -n "$DOWNLOAD_URL" ] || { echo 'Error: failed to resolve latest Ghidra release' >&2; exit 1; }

echo "[*] Downloading latest Ghidra release..."
mkdir -p "$TMPDIR"
wget --show-progress -q --progress=bar:force:noscroll \
     "$DOWNLOAD_URL" -O "$TMPDIR/ghidra.zip"

echo "[*] Installing to $GHIDRA_DIR..."
[ -d "$GHIDRA_DIR" ] && rm -rf "$GHIDRA_DIR"
unzip -q "$TMPDIR/ghidra.zip" -d "$PREFIX/share"
find "$PREFIX/share" -maxdepth 1 -type d -name 'ghidra_*_PUBLIC' -exec mv {} "$GHIDRA_DIR" \;

echo "[*] Creating launcher..."
cat > "$PREFIX/bin/ghidra" <<EOF
#!/data/data/com.termux/files/usr/bin/bash
export _JAVA_OPTIONS="-Duser.home=\$HOME -Xmx2G"
cd "$GHIDRA_DIR" && ./ghidraRun "\$@"
EOF
chmod +x "$PREFIX/bin/ghidra"

mkdir -p "$DESKTOP_DIR"
cat > "$DESKTOP_DIR/ghidra.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Ghidra
Comment=Software Reverse Engineering Suite
Exec=ghidra
Icon=ghidra
Categories=Development;
Terminal=false
EOF

echo -e "\n[√] Ghidra installed successfully!"
echo "Run: ghidra (GUI) or ghidra --analyzeHeadless (CLI)"
exit 0
