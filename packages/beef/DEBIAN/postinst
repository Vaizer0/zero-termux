#!/data/data/com.termux/files/usr/bin/bash
set -e

BEEF_DIR="$PREFIX/share/beef"
LAUNCHER="$PREFIX/bin/beef"
# Zero-Termux: rolling — resolve latest upstream release tag at install time
VERSION="$(curl -fsSL --max-time 30 'https://api.github.com/repos/beefproject/beef/releases/latest' 2>/dev/null | grep '"tag_name"' | head -1 | cut -d'"' -f4 | sed 's/^v//')"
[ -n "$VERSION" ] || { echo 'Error: failed to resolve latest BeEF release' >&2; exit 1; }
TARBALL_URL="https://github.com/beefproject/beef/archive/refs/tags/v${VERSION}.tar.gz"

[ -d "$BEEF_DIR" ] && rm -rf "$BEEF_DIR"
mkdir -p "$BEEF_DIR"

cd "$TMPDIR"
curl -L -o beef.tar.gz "$TARBALL_URL"
tar -xzf beef.tar.gz --strip-components=1 -C "$BEEF_DIR"
rm beef.tar.gz

cd "$BEEF_DIR"
rm -f Gemfile.lock

# Remove curb and nokogiri from Gemfile (provided as system dependencies)
sed -i '/^gem .curb./d' Gemfile
sed -i '/^gem .nokogiri./d' Gemfile

gem install sqlite3 -- --enable-system-libraries
gem install bundler
bundle install

# Correct displayed version in config.yaml (upstream hardcodes an old one)
sed -i "s/^\([[:space:]]*version:\)[[:space:]]*'0\.5\.4\.0'/\1 '$VERSION'/" config.yaml

# Change default password from "beef" to "zero-termux"
sed -i 's/^\([[:space:]]*passwd:\)[[:space:]]*"beef"/\1 "zero-termux"/' config.yaml

cat > "$LAUNCHER" << 'EOF'
#!/data/data/com.termux/files/usr/bin/bash
cd "$PREFIX/share/beef" && exec ruby beef "$@"
EOF
chmod +x "$LAUNCHER"

echo "BeEF v$VERSION installed."
echo "Default panel: http://127.0.0.1:3000/ui/panel (beef:zero-termux)"
echo "Configuration: $BEEF_DIR/config.yaml"
exit 0
