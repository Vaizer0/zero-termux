#!/data/data/com.termux/files/usr/bin/bash
set -e

# Zero-Termux: rolling — resolve latest upstream release tag at install time
VERSION="$(curl -fsSL --max-time 30 'https://api.github.com/repos/hahwul/dalfox/releases/latest' 2>/dev/null | grep '"tag_name"' | head -1 | cut -d'"' -f4 | sed 's/^v//')"
[ -n "$VERSION" ] || { echo 'Error: failed to resolve latest dalfox release' >&2; exit 1; }
BUILD_DIR="$TMPDIR/dalfox-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -L -o "dalfox-${VERSION}.tar.gz" \
  "https://github.com/hahwul/dalfox/archive/refs/tags/v${VERSION}.tar.gz"

tar -xzf "dalfox-${VERSION}.tar.gz"
cd "dalfox-${VERSION}"

cargo build --release --locked

install -Dm755 target/release/dalfox "$PREFIX/bin/dalfox"

cd /
rm -rf "$BUILD_DIR"

exit 0
